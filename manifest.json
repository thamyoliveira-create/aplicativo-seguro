  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            ".pdf",
            ".doc",
            ".docx",
            ".xlsx",
            ".txt"
          ]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+atividade",
      "url": "/?codigo=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "text/plain": [
          ".txt"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "application/msword": [
          ".doc",
          ".docx"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/vnd.ms-excel": [
          ".xlsx",
          ".xls"
        ]
      }
    }
  ]
