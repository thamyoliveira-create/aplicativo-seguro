# ============================================================
# ATIVIDADE SEGURA - VARIÁVEIS DE AMBIENTE
# ============================================================
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commit .env em Git!

# ============================================================
# FIREBASE CONFIGURATION
# ============================================================
VITE_FIREBASE_API_KEY=seu_firebase_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu_projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu_projeto_id
VITE_FIREBASE_STORAGE_BUCKET=seu_projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=seu_sender_id
VITE_FIREBASE_APP_ID=seu_app_id
VITE_FIREBASE_MEASUREMENT_ID=seu_measurement_id

# ============================================================
# GOOGLE GEMINI API
# ============================================================
VITE_GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-1.5-flash

# ============================================================
# SERVIDOR BACKEND
# ============================================================
PORT=3000
HOST=localhost
NODE_ENV=development
LOG_LEVEL=info

# ============================================================
# SEGURANÇA
# ============================================================
JWT_SECRET=sua_chave_jwt_super_segura_com_min_32_caracteres
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_ENABLED=true

# ============================================================
# VARIÁVEIS OPCIONAIS
# ============================================================
DEBUG=false
ENABLE_CORS=true
ENABLE_PWA=true
OFFLINE_MODE=true
